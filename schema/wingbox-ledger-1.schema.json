{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aileron-tech/wingbox-action/blob/main/schema/wingbox-ledger-1.schema.json",
  "title": "Wingbox evidence ledger line, version 1",
  "description": "One line of a ledger: the record of one run in short, with the SHA-256 of the line before it. A ledger is a text file of such lines, each JSON with its keys in order and no space, ended by a line feed; lines are added at the end and never changed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sequence", "previous", "key", "time", "repository", "change", "base", "head", "commit", "verdicts", "eligible", "reasons", "policy", "accepted", "accepted-count", "expired-count", "record-sha256", "package"],
  "properties": {
    "schema": {"type": "string", "enum": ["wingbox-ledger/1"]},
    "sequence": {"type": "integer", "description": "1 for the first line; one more than the line before."},
    "previous": {"type": "string", "pattern": "^([0-9a-f]{64})?$", "description": "The SHA-256 of the line before, without its line end; empty for the first line."},
    "key": {"type": "string", "description": "The run: provider/repository/run id/attempt/job."},
    "time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "description": "The time of the record (its `generated`), UTC."},
    "repository": {"type": "string"},
    "change": {"type": "string", "description": "The number of the pull or merge request; empty outside one."},
    "base": {"type": "string"},
    "head": {"type": "string"},
    "commit": {"type": "string", "description": "The commit whose files were checked; empty when the record names none."},
    "verdicts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boundaries", "existing", "baseline", "tests", "coverage", "execution"],
      "properties": {
        "boundaries": {"type": "string", "enum": ["PASS", "FAIL", "UNKNOWN", "NOT_APPLICABLE"]},
        "existing": {"type": "string", "enum": ["NONE", "PRESENT", "UNKNOWN"]},
        "baseline": {"type": "string", "enum": ["NONE", "ACCEPTED", "EXPIRED", "UNKNOWN"]},
        "tests": {"type": "string", "enum": ["none", "none-found", "complete", "incomplete", "failed"]},
        "coverage": {"type": "string", "enum": ["complete", "incomplete"]},
        "execution": {"type": "string", "enum": ["ok", "error"]}
      }
    },
    "eligible": {"type": "boolean", "description": "Whether the record is fit to count as evidence, as the record says."},
    "reasons": {"type": "array", "description": "Why it is not eligible.", "items": {"type": "string"}},
    "policy": {
      "type": "array",
      "description": "The policy files the change of this run edits.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "change"],
        "properties": {"path": {"type": "string"}, "kind": {"type": "string"}, "change": {"type": "string", "enum": ["added", "changed", "removed"]}}
      }
    },
    "accepted": {
      "type": "array",
      "description": "The breaks the baseline accepts at this run, and the entries past their end date.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding", "text", "owner", "expires", "state"],
        "properties": {
          "finding": {"type": "string"},
          "text": {"type": "string"},
          "owner": {"type": "string"},
          "expires": {"type": "string"},
          "state": {"type": "string", "enum": ["accepted", "expired"]}
        }
      }
    },
    "accepted-count": {"type": "integer", "description": "The number of accepted breaks; the record lists at most 100 of them."},
    "expired-count": {"type": "integer"},
    "record-sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "The SHA-256 of wingbox-evidence.json."},
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest-sha256", "bundle", "state"],
      "description": "The package of the run: the SHA-256 of its manifest (what a review names, and what stays the same when reviews are added), its bundle id and its state; `none` with empty values for a line written from a record alone.",
      "properties": {
        "manifest-sha256": {"type": "string", "pattern": "^([0-9a-f]{64})?$"},
        "bundle": {"type": "string", "pattern": "^([0-9a-f]{64})?$"},
        "state": {"type": "string", "enum": ["complete", "incomplete", "none"]}
      }
    }
  }
}
